# Copy to .env.local for local development. Never commit real values; CI fails if
# any .env file other than this one is tracked. Each variable says where it
# lives in production so a 2am deploy does not have to guess.
#
# Required now (the server refuses to start without them, see src/lib/env.ts):
#   NEXT_PUBLIC_SITE_URL
# Required from the REQ that introduces them: see REQUIRED_LATER in src/lib/env.ts.
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle at build time.

# --- App ---
# Public origin of the site, no trailing slash. Production: Vercel project environment variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Product name shown in the UI. Defaults to Readyline in code (D-027); set only to
# override (must not contain "NDIS", CLAUDE.md 4.1).
# Production: Vercel project environment variables.
NEXT_PUBLIC_BRAND_NAME=Readyline

# --- Legal and trust pages - REQ-008 ---
# Public contact address behind the footer's Contact link (mailto) and named on the
# legal pages. Leave unset until chosen: the footer then shows no Contact link and the
# legal-copy test prints a warning. Read on the server only.
# Production: Vercel project environment variables.
CONTACT_EMAIL=
# Optional, 11 digits. The footer shows an ABN line only when it is set.
# Production: Vercel project environment variables.
BUSINESS_ABN=

# --- Supabase (project ref dpwwzhylcyosnkmlcnnp, ap-southeast-2) - REQ-004 ---
# New API key format: publishable (browser and SSR) and secret (server only).
# Dashboard: Project Settings, API Keys. Production: Vercel project environment variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefixed NEXT_PUBLIC_, never imported outside src/server/**.
SUPABASE_SECRET_KEY=

# --- Scheduled jobs - REQ-004 Session C ---
# Bearer token Vercel Cron sends to /api/jobs/purge (daily purge of accounts deleted 30+ days ago)
# and /api/jobs/generate (REQ-007: the paid generation job; the webhook also uses it to hand a
# long set from one short run to the next, D-707).
# Generate with: openssl rand -hex 32. Production: Vercel project environment variables (server only).
# Leave empty locally; the route then answers 404 to everyone.
CRON_SECRET=

# --- Anthropic (document generation) - required from REQ-005 ---
# Server only. Production: Vercel project environment variables; key created in the Anthropic console with a monthly spend cap.
ANTHROPIC_API_KEY=
# Model id chosen in REQ-005 and recorded in DECISIONS.md.
ANTHROPIC_MODEL=
# Feature flag for document generation (REQ-005 FR-9): false shows 'coming soon' and no endpoint generates.
GENERATION_ENABLED=false
# Set to 1 only when re-recording model fixtures locally (REQ-005 D-502); CI never sets it.
GENERATION_RECORD=
# Production switch for the paid generation job (REQ-007 FR-5, D-708): 1 calls the model for
# real customers; anything else replays recorded fixtures and fails loudly on a missing one.
# Production: Vercel project environment variables (server only).
GENERATION_LIVE=

# --- Stripe (one-off pack + subscription) - required from REQ-007 ---
# Server only. Production: Vercel project environment variables; restricted key from the Stripe dashboard.
STRIPE_SECRET_KEY=
# Server only. Production: Vercel project environment variables; from the Stripe webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=
# Public. Production: Vercel project environment variables.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The one-off pack's Price id (AUD, created once in the dashboard). Production: Vercel project environment variables.
STRIPE_PRICE_PACK=
# Display values for the pricing page (REQ-007 FR-1, FR-9). PACK_PRICE_AUD_CENTS must equal the
# Price's unit_amount; a live key checks this at start. GST_LINE is the sentence shown beside the
# price, for example "No GST while Readyline is not registered for GST." Production: Vercel.
PACK_PRICE_AUD_CENTS=
GST_LINE=
# Optional display value for the subscription shown as "coming" (REQ-009 adds the real product).
SUBSCRIPTION_PRICE_AUD_CENTS=
# Fake Checkout for local and CI end-to-end runs (REQ-007 D-709): 1 replaces Stripe's hosted
# Checkout with a page on this origin that posts signed events to the real webhook route.
# Ignored on Vercel production and beside a live key. Never set it in production.
STRIPE_FAKE=

# --- Transactional email (register reminders) - required from REQ-009, provider TBD (D-013) ---
# Production: Vercel project environment variables.
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# --- Error tracking - from REQ-010 ---
# Production: Vercel project environment variables; DSNs from the Sentry project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
