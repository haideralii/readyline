# Copy to .env.local for local development. Never commit real values; CI fails if
# any .env file other than this one is tracked. This file is the single list of
# variable names the code reads (REQ-010 FR-3; a unit test checks it). Each line
# says where the value comes from and where it lives in production.
#
# Required everywhere (the server refuses to start without them, src/lib/env.ts):
#   NEXT_PUBLIC_SITE_URL
# Required on the Vercel production deployment (PRODUCTION_REQUIRED in src/lib/env.ts;
# the prebuild check and the boot check refuse a production build or start without them):
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
#   CRON_SECRET, ANTHROPIC_API_KEY, CONTACT_EMAIL, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   STRIPE_PRICE_PACK, PACK_PRICE_AUD_CENTS, GST_LINE, HASH_PEPPER
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle at build time; every
# other variable is server-only and must be marked so in Vercel (not "exposed to the browser").
# In Vercel, NEXT_PUBLIC_* rows must be type "Config", not "Secret" (a Secret-typed public
# variable never saves); the three Stripe values must come from one account in one mode.
# The deploy runbook is supabase/ops/DEPLOY.md.

# --- App ---
# Public origin of the site, no trailing slash. Production: Vercel project environment variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Product name shown in the UI. Defaults to Readyline in code (D-027); set only to
# override (must not contain "NDIS", CLAUDE.md 4.1).
# Production: Vercel project environment variables.
NEXT_PUBLIC_BRAND_NAME=Readyline

# --- Legal and trust pages - REQ-008 ---
# Public contact address behind the footer's Contact link (mailto), named on the legal
# pages and used for refund requests (REQ-007). Required in production. Read on the server.
# Production: Vercel project environment variables.
CONTACT_EMAIL=
# Optional, 11 digits. The footer shows an ABN line only when it is set.
# Production: Vercel project environment variables.
BUSINESS_ABN=
# The registered business name; with BUSINESS_ABN set, the home page says who runs the site (batch 45 item 1).
BUSINESS_NAME=

# --- Supabase (project ref dpwwzhylcyosnkmlcnnp, ap-southeast-2) - REQ-004 ---
# New API key format: publishable (browser and SSR) and secret (server only).
# Dashboard: Project Settings, API Keys. Production: Vercel project environment variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefixed NEXT_PUBLIC_, never imported outside src/server/**.
SUPABASE_SECRET_KEY=

# --- Scheduled jobs - REQ-004 Session C, REQ-007 ---
# Bearer token Vercel Cron sends to /api/jobs/purge (daily purge of accounts deleted 30+ days
# ago) and /api/jobs/generate (the paid generation job; the webhook also uses it to hand a long
# set from one short run to the next, D-707). Vercel reads CRON_SECRET itself for its cron calls.
# Generate with: openssl rand -hex 32. Production: Vercel project environment variables (server only).
# Leave empty locally; the routes then answer 404 to everyone.
CRON_SECRET=

# --- Keyed hashes - REQ-020 Session B (retro finding 34) ---
# HMAC key behind the hashed viewer addresses on audit lines and the hashed emails on worker
# invitations and limiter keys (src/lib/peppered-hash.ts). Generate with: openssl rand -hex 32.
# Set once and keep it: a change orphans every open invitation. Until it is set, in any
# environment, the hashes are plain SHA-256 as before and one warning is logged (D-2238).
# Production: Vercel project environment variables (server only).
HASH_PEPPER=

# --- Anthropic (document generation) - REQ-005 ---
# Server only. Production: Vercel project environment variables; key created in the Anthropic
# console with a monthly spend cap.
ANTHROPIC_API_KEY=
# Model id chosen in REQ-005 and recorded in DECISIONS.md (D-048: claude-sonnet-5-5); the code
# defaults to that id when unset.
ANTHROPIC_MODEL=
# Feature flag for document generation (REQ-005 FR-9): true shows the Generate and Buy
# controls on /documents; unset or false shows one line saying generation is not switched on
# in this environment (batch 45 item 2). Production must carry true, or nothing can be bought.
GENERATION_ENABLED=false
# Set to 1 only when re-recording model fixtures locally (REQ-005 D-502); CI never sets it.
GENERATION_RECORD=
# Production switch for real model calls (REQ-007 FR-5, D-708): 1 calls the model for
# customers; anything else replays recorded fixtures and fails loudly on a missing one.
# Set it to 1 for the trial. Production: Vercel project environment variables (server only).
GENERATION_LIVE=

# --- Stripe (one-off pack) - REQ-007 ---
# Server only. Production: Vercel project environment variables; a restricted key from the
# Stripe dashboard (test mode for the trial).
STRIPE_SECRET_KEY=
# Server only. From the dashboard webhook endpoint for https://<domain>/api/stripe/webhook
# (production), or from `stripe listen` locally. Production: Vercel project environment variables.
STRIPE_WEBHOOK_SECRET=
# The one-off pack's Price id (AUD, created once in the dashboard). Production: Vercel.
STRIPE_PRICE_PACK=
# The recurring Price for the registers subscription (REQ-009 Session C): a monthly AUD
# price created in the Stripe dashboard (test mode for the trial), no trial, no setup fee.
# Optional: until it is set the Subscribe button is hidden and the pricing page says "coming".
STRIPE_PRICE_REGISTERS=
# Display values for the pricing page (REQ-007 FR-1, FR-9). PACK_PRICE_AUD_CENTS must equal the
# Price's unit_amount; a live key checks this at start and refuses to serve on a mismatch.
# GST_LINE is the sentence shown beside the price, for example
# "No GST while Readyline is not registered for GST." Production: Vercel.
PACK_PRICE_AUD_CENTS=
GST_LINE=
# Optional display value for the subscription shown as "coming soon" (REQ-009 adds the product).
SUBSCRIPTION_PRICE_AUD_CENTS=
# Fake Checkout for local and CI end-to-end runs (REQ-007 D-709): 1 replaces Stripe's hosted
# Checkout with a page on this origin that posts signed events to the real webhook route.
# Ignored on Vercel production and beside a live key. Never set it in production.
STRIPE_FAKE=

# --- Transactional email - REQ-022 Session B (D-2822: plain SMTP, no vendor code) ---
# EMAIL_PROVIDER: "log" (the default; messages are logged with the address hashed, never sent) or
# "smtp". With "smtp" the five values below are read on the server (src/server/email/provider.ts)
# and the same five go into Supabase, Authentication, SMTP Settings, so sign-in mail and product
# mail come from one sender. HASH_PEPPER must be set too (the unsubscribe token hangs off it).
# Whichever sender Haider chooses on the launch day is these values and nothing else.
# Production: Vercel project environment variables (SMTP_PASS server only).
EMAIL_PROVIDER=
# The sender, "Readyline <no-reply@<domain>>"; the reply-to is CONTACT_EMAIL.
EMAIL_FROM=
SMTP_HOST=
# 465 for TLS from the first byte; 587 for STARTTLS.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Error tracking - REQ-010 part 2 ---
# Not read by the code yet. Production: Vercel project environment variables; DSNs from Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Local tooling only (REQ-022 Session A, D-2210) ---
# The local Supabase stack's Postgres URL (`supabase status -o env`, DB_URL). CI's Supabase job
# exports it; the admin e2e raises its throwaway platform admin through psql with it, the way an
# operator would, because the users trigger refuses that change from any API call. Never the
# hosted project's URL, never needed on Vercel.
SUPABASE_DB_URL=

# --- Local tooling only (REQ-015 FR-19) ---
# scripts/ops/lighthouse.mjs runs Lighthouse in this Chrome; unset, it finds Playwright's Chromium.
# Never needed on Vercel.
CHROME_PATH=

# --- GitHub Actions kicker (batch 32, D-1006; D-059) ---
# scripts/ops/kick-generation.mjs calls /api/jobs/generate until it reports nothing more to do.
# In GitHub: PROD_URL is a repository variable (https://<domain>, no trailing slash) and
# CRON_SECRET (above) a repository secret with the same value as Vercel's. Never needed on Vercel.
# KICK_MAX_SECONDS caps one run (the workflow sets 1200) so it ends before the next
# thirty-minute schedule.
PROD_URL=
KICK_MAX_SECONDS=
# Optional, server only (D-059): a fine-grained GitHub token for this repository alone with
# Contents: read and write (what the repository_dispatch endpoint requires). With it the app
# starts the kicker workflow the moment a pack is paid for or a stalled job is nudged; without
# it the dispatch is skipped with one log line and the schedule picks the job up within thirty
# minutes. Production: Vercel project environment variables (server only); runbook section 8a.
GITHUB_DISPATCH_TOKEN=
