# Copy to .env.local for local development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Product name. Defaults to Readyline in code (D-027); set only to override
# (must not contain "NDIS" - see CLAUDE.md section 4.1).
NEXT_PUBLIC_BRAND_NAME=Readyline

# --- Supabase (Sydney region project) - from Phase 2 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (document generation) - from Phase 3 ---
ANTHROPIC_API_KEY=
# Model id is chosen in Phase 3 and recorded in DECISIONS.md.
ANTHROPIC_MODEL=

# --- Stripe (one-off purchase + subscription) - from Phase 4 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_DOCUMENT_SET=
STRIPE_PRICE_SUBSCRIPTION_MONTHLY=

# --- Transactional email (register reminders) - from Phase 5, provider TBD ---
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# --- Error tracking - from Phase 4 ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
