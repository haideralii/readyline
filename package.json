{
  "name": "readiness-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 16",
    "ios_saf >= 16"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/check-env.ts",
    "build": "next build",
    "smoke": "node scripts/ops/smoke.mjs",
    "check:bundle": "node scripts/ci/check-client-bundle.mjs",
    "generator:skeletons": "vitest run src/lib/generator/skeletons.test.ts",
    "generation:record": "vitest run src/lib/generator/record-fixtures.test.ts",
    "generation:review-pack": "vitest run src/lib/generator/review-pack.test.ts",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf:budget": "vitest run scripts/ops/lighthouse-budget.test.ts",
    "standards:build": "node scripts/standards/build.mjs",
    "standards:verify": "node scripts/standards/verify.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "standards:report": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/standards/report.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:env-files": "node scripts/ci/check-env-files.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "generator:exam": "vitest run src/lib/generator/exam.test.ts",
    "generator:exam:live": "vitest run src/lib/generator/exam-live.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@types/nodemailer": "^6.4.24",
    "@vercel/functions": "^3.9.11",
    "docx": "^9.10.0",
    "fflate": "^0.8.3",
    "next": "16.4.0",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
